services:
  awg-mesh-node:
    image: {{.Image}}
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
      - NET_RAW
    devices:
      - /dev/net/tun:/dev/net/tun
    sysctls:
      net.ipv4.ip_forward: "1"
    environment:
      # Bootstrap: written to /config/mesh.token on first boot, then ignored.
      - MESH_TOKEN_HASH={{.TokenHash}}
      - MESH_MODE=master
      - MESH_NAME={{.Name}}
      - MESH_OVERLAY_IP={{.OverlayIP}}
      - MESH_LISTEN_PORT={{.ListenPort}}
      - MESH_CONFIG_DIR=/config
      # Bind to all interfaces so Traefik can scrape metrics from the sidecar.
      - MESH_METRICS_ADDR=0.0.0.0:9091
    volumes:
      - /srv/awg-mesh/{{.Name}}:/config
    ports:
      # AWG data plane — DIRECT, bypasses Traefik (UDP, source IP preservation).
      - "{{.ListenPort}}:{{.ListenPort}}/udp"
    labels:
      # gRPC management — via Traefik TCP with mTLS passthrough.
      - "traefik.enable=true"
      - "traefik.tcp.routers.awg-grpc-{{.Name}}.entrypoints=awg-grpc"
      - "traefik.tcp.routers.awg-grpc-{{.Name}}.rule=HostSNI(`*`)"
      - "traefik.tcp.routers.awg-grpc-{{.Name}}.tls.passthrough=true"
      - "traefik.tcp.routers.awg-grpc-{{.Name}}.service=awg-grpc-{{.Name}}-svc"
      - "traefik.tcp.services.awg-grpc-{{.Name}}-svc.loadbalancer.server.port=9090"
      # Prometheus metrics — via Traefik HTTP.
      - "traefik.http.routers.awg-metrics-{{.Name}}.rule=Host(`{{.Host}}`) && PathPrefix(`/metrics`)"
      - "traefik.http.routers.awg-metrics-{{.Name}}.entrypoints=web"
      - "traefik.http.routers.awg-metrics-{{.Name}}.service=awg-metrics-{{.Name}}-svc"
      - "traefik.http.services.awg-metrics-{{.Name}}-svc.loadbalancer.server.port=9091"
