services:
  awg-mesh-node:
    image: {{.Image}}
    network_mode: host
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
      - NET_RAW
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      # Bootstrap: written to /config/mesh.token on first boot, then ignored.
      - MESH_TOKEN_HASH={{.TokenHash}}
      - MESH_MODE=client
      - MESH_NAME={{.Name}}
      - MESH_OVERLAY_IP={{.OverlayIP}}
    dns:
      - 1.1.1.1
      - 8.8.8.8
    mem_limit: 256m
    shm_size: 64m
    stop_grace_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    volumes:
      - /var/lib/awg-mesh/{{.Name}}:/config
