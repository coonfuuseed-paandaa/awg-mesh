services:
  awg-mesh-node:
    image: {{.Image}}
    network_mode: host
    restart: unless-stopped
    cap_add:
      - NET_ADMIN
      - NET_RAW
    devices:
      - /dev/net/tun:/dev/net/tun
    environment:
      # Bootstrap: written to /config/mesh.token on first boot, then ignored.
      - MESH_TOKEN_HASH={{.TokenHash}}
      - MESH_MODE=master
      - MESH_NAME={{.Name}}
      - MESH_OVERLAY_IP={{.OverlayIP}}
      - MESH_LISTEN_PORT={{.ListenPort}}
      - MESH_CONFIG_DIR=/config
    volumes:
      - /var/lib/awg-mesh/{{.Name}}:/config
